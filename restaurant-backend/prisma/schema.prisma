generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
}

model Admin {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  password        String
  lastLogin       DateTime?
  errorLoginCount Int       @default(0) @db.SmallInt
  randToken       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Otp {
  id            Int      @id @default(autoincrement())
  email         String   @unique @db.VarChar(255)
  otp           String
  rememberToken String
  verifyToken   String?
  count         Int      @default(0) @db.SmallInt
  error         Int      @default(0) @db.SmallInt
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(52)
  menuItems MenuItem[]
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(52)
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  images         Image[]
  productOptions ProductOption[]
  orderItems     OrderItem[]
}

model Image {
  id   Int    @id @default(autoincrement())
  path String @db.VarChar(255)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

model ProductOption {
  id              Int     @id @default(autoincrement())
  name            String  @db.VarChar(100)
  additionalPrice Decimal @default(0) @db.Decimal(10, 2)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
}

model RestaurantTable {
  id          Int         @id @default(autoincrement())
  tableNumber Int         @unique
  qrCode      String      @unique @db.VarChar(255)
  status      TableStatus @default(AVAILABLE)

  orders Order[]
}

model Order {
  id         Int      @id @default(autoincrement())
  totalPrice Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tableId Int
  table   RestaurantTable @relation(fields: [tableId], references: [id])

  orderItems OrderItem[]
}

model OrderItem {
  id       Int     @id @default(autoincrement())
  quantity Int     @default(1) @db.SmallInt
  price    Decimal @db.Decimal(10, 2)
  note     String? @db.VarChar(255)

  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productOptionId Int?
  productOption   ProductOption? @relation(fields: [productOptionId], references: [id])
}
