# development | production
NODE_ENV=development
PORT=8081
APP_DEBUG=true

# JWT signing secrets — generate real random values for any non-local use,
# e.g. `openssl rand -hex 32`. Never reuse the committed example values.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-string
REFRESH_TOKEN_SECRET=change-me-to-a-different-long-random-string

# Redis (used for response caching and the BullMQ job queues)
REDIS_HOST=localhost
REDIS_PORT=6379

# Resend (https://resend.com) — used to email OTP codes for
# registration and password reset. Get an API key from the Resend
# dashboard. RESEND_FROM_EMAIL can stay as the sandbox sender below
# until you verify your own domain with Resend.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# PostgreSQL connection string (Prisma format). See
# https://pris.ly/d/connection-strings for the full syntax.
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?sslmode=require"
