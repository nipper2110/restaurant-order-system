{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2022"],

    "module": "CommonJS",
    "moduleResolution": "Node",

    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["./*.js", "src/**/*.ts", "test/**/*.ts", "config/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
